---
interface Props {
	title: string
	description: string
	noindex?: boolean
}

const { title, description, noindex = false } = Astro.props
import '@fontsource/geist-mono'
import '@/styles/global.css'
import { ClientRouter } from 'astro:transitions'
import { SEO } from 'astro-seo'
import { getLangFromUrl, getTranslatedPath } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const site = Astro.site!
const canonical = new URL(Astro.url.pathname, site).href
const alternate = (locale: 'en' | 'es') =>
	new URL(getTranslatedPath(Astro.url.pathname, locale), site).href
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<SEO
			title={title}
			titleTemplate="%s :: Coke Posada"
			description={description}
			canonical={canonical}
			noindex={noindex}
			openGraph={{
				basic: {
					title,
					type: 'website',
					image: new URL('/og-image.jpg', site).href
				},
				image: {
					alt: 'Astro Full Starter by Coke Posada'
				},
				optional: {
					description: description
				}
			}}
			twitter={{
				creator: '@cokeposada'
			}}
		/>
		{!noindex && (
			<>
				<link rel="alternate" href={alternate('en')} hreflang="en" />
				<link rel="alternate" href={alternate('es')} hreflang="es" />
				<link rel="alternate" href={alternate('en')} hreflang="x-default" />
			</>
		)}
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<ClientRouter />
	</head>
	<body>
		<slot />
	</body>
</html>
